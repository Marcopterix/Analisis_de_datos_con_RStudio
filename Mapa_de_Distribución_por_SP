########## Creación de df por estados ##########


Estados <- c("Baja California", "Baja California Sur",  "Sonora", "Sinaloa", "Chihuahua", "Durango",
            "Coahuila de Zaragoza", "Nuevo León", "Tamaulipas",
            "Nayarit", "Jalisco", "Colima", "Michoacán de Ocampo",
            "Veracruz de Ignacio de la Llave", "Puebla", "Tlaxcala", "Hidalgo",
            "Aguascalientes", "Guanajuato", "Querétaro", "San Luis Potosí", "Zacatecas",
            "Ciudad de México", "México", "Morelos",
            "Tabasco", "Campeche", "Yucatán", "Quintana Roo",
            "Guerrero", "Oaxaca", "Chiapas")
  
Estados <- data.frame(Estados)  

  Estados <- Estados %>%
    mutate(
      Region = case_when(
        
        Estados %in% c("Baja California", "Baja California Sur", "Sonora", "Sinaloa", "Chihuahua", "Durango") ~ "Noroeste",
        Estados %in% c("Coahuila de Zaragoza", "Nuevo León", "Tamaulipas" ) ~ "Noreste",
        Estados %in% c("Nayarit", "Jalisco", "Colima", "Michoacán de Ocampo") ~ "Occidente",
        Estados %in% c("Veracruz de Ignacio de la Llave", "Puebla", "Tlaxcala", "Hidalgo") ~ "Oriente",
        Estados %in% c("Aguascalientes", "Guanajuato", "Querétaro", "San Luis Potosí", "Zacatecas") ~ "Centronorte",
        Estados %in% c("Ciudad de México", "México", "Morelos") ~ "Centrosur",
        Estados %in% c("Tabasco", "Campeche", "Yucatán", "Quintana Roo") ~ "Sureste",
        Estados %in% c("Guerrero", "Oaxaca", "Chiapas") ~ "Suroeste",
        TRUE ~ NA_character_
      )
    )
  
  colnames(Estados) <- c("NOMBRE", "Region")

#####

estad_mex_map_rabia <- estados_mex %>%
  left_join(Estados, by = "NOMBRE")



#Cargar datos

positivos <- read_xlsx("Documentos/RABV/Dist_Map_Mex.xlsx")

positivos$CVEGEO <- as.character(positivos$CVEGEO)

mex_map_rabia <- mex_map %>%
  left_join(positivos, by = "CVEGEO")

