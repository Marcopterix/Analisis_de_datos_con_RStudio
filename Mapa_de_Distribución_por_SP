##################### Mapa de regiones con datos  ###############################
ggplot(data = mex_map_rabia) +
  geom_sf(aes(fill = AgV), color = "#7B868C", size = 0.1) +
  #geom_sf(data = estad_mex_map_rabia, aes(color = Region), fill = NA) + 
  geom_sf(data = estad_mex_map_rabia, fill = NA, aes( color = Region), size = 0.8) +
  scale_color_manual(
    values = c(
      "Noroeste"    = "red",
      "Noreste"     = "#F39C12",
      "Occidente"   = "#F1D500",
      "Oriente"     = "#C52BE8",
      "Centronorte" = "#18A9D1",
      "Centrosur"   = "green",
      "Sureste"     = "#B7F000",
      "Suroeste"    = "#4b0082"
    ),
    na.value = "white",
    name = "Región"
  ) +
  scale_fill_brewer("Clado por municipio", palette = "Set1", na.value = "white") +
  annotation_north_arrow(location='tr') +
  annotation_scale() +
  theme_bw() 


